# Порт запуска приложения
BIND_PORT=5005
BIND_IP=127.0.0.1

# Путь к базе данных
DATABASE_PATH=./data/sli_dashboard.db

# Секретный ключ Flask (замените на случайную строку)
SECRET_KEY=zabbix_sli_secret_key_8899_prod

# ----------------------------------------------------
# Авторизация через Active Directory / LDAP
# ----------------------------------------------------
# Включить авторизацию через домен (true / false)
LDAP_ENABLED=false

# Адрес контроллера домена или сервера LDAP (например ldap://dc1.company.local или ldaps://dc1.company.local)
LDAP_SERVER=ldap://dc1.company.local
LDAP_PORT=389
LDAP_USE_SSL=false

# Домен компании (например company.local)
LDAP_DOMAIN=company.local

# Базовый DN для поиска пользователей и групп
LDAP_BASE_DN=DC=company,DC=local

# Сервисная учетная запись для первичного поиска (Search-then-Bind)
LDAP_BIND_USER=svc_zabbix_sli
LDAP_BIND_PASSWORD=YourStrongServicePassword

# Обязательная группа для доступа к панели (если пусто — доступ открыт всем доменным пользователям)
LDAP_REQUIRED_GROUP=SLA-Monitoring-Users

# Доменная группа, члены которой автоматически получают права администратора в Zabbix-SLI
LDAP_ADMIN_GROUP=Domain Admins

# Список конкретных логинов (через запятую), которые всегда получают роль администратора
LDAP_ADMIN_USERS=admin,sysadmin

# Проверять рекурсивно вложенные группы Active Directory
LDAP_NESTED_GROUPS=true
